{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build && cd .. && rm -rf public && cp -r frontend/dist public",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,public/**,docs/**,databases/raw/**,databases/extracted/**,samples/formats/**,**/__pycache__/**,**/node_modules/**}"
    }
  }
}
